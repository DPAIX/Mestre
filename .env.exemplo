# Copie este arquivo como .env. NUNCA envie .env no Telegram nem ao GitHub.
# REVOGUE as credenciais antigas que estiveram embutidas no código original.
TELEGRAM_TOKEN=COLOQUE_NOVO_TOKEN_AQUI
TELEGRAM_ALLOWED_USER_IDS=SEU_ID_NUMERICO
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EXA_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Interactions é a integração atual. Configurações antigas sem esta opção
# continuam usando generate_content. Agentes exigem google-genai>=2.9 e cota.
GEMINI_API_MODO=interactions
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
PAINEL_PORTA=8765
# Opcional: diretório com os arquivos da versão anterior (migrados uma única vez).
# CAMINHO_LEGADO=C:\Users\SEU_USUARIO\Desktop
# ROBOTASK_TASKS_DIR=C:\Users\SEU_USUARIO\AppData\Local\RoboTask\Tasks
# Opcional: integração Google Calendar leitura (ative usando autorizar_google.bat)
# GOOGLE_OAUTH_CREDENTIALS=C:\Users\SEU_USUARIO\Desktop\credentials.json

# Agendador: autoanálise SOMENTE LEITURA a cada 360 min (mínimo 15).
AUTOANALISE_INTERVALO_MIN=360
# Reinício completo do Windows DESABILITADO por padrão. Altere para 1 conscientemente.
# Com timeout > 0 o Windows pode forçar fechamento de programas ao fim da espera.
REINICIO_WINDOWS_HABILITADO=0
REINICIO_WINDOWS_ATRASO_SEG=120

# Ollama opcional: configurar_ia_local.bat --listar reaproveita seu catalogo.
# Ex.: --modelo qwen3.5:4b, se ja listado. Modelos -cloud/:cloud usam conta/internet/cota.
# O modelo padrao abaixo pode ser substituido por conversa no painel/Telegram.
OLLAMA_HABILITADO=1
# 0 mantém o início do Ollama sob seu controle; 1 permite iniciar serve se ausente.
# Não afeta um serviço já aberto e não altera a rede do Windows.
OLLAMA_INICIAR_SERVICO=0
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Perfil padrao deixa o Ollama escolher a execucao. cpu usa contexto pequeno/saida curta.
# Use /modelos perfil cpu ou configurar_ia_local.bat --perfil-cpu para selecionar Llama local.
OLLAMA_PERFIL=padrao
# Excecao opcional para modelos cloud no perfil CPU; ative no painel apos revisar o envio de historico.
# Nao altera permissoes do perfil padrao do servico ou dos aplicativos externos.
OLLAMA_NUVEM_HABILITADA=0
# Equipe adaptativa: usa o prazo individual por participante (90 s por padrao),
# com orcamento acumulado e teto de 900 s para novos envios. Nao garante cancelamento remoto.
OLLAMA_EQUIPE_ORCAMENTO=adaptativo
# O par legado 90/30 abaixo e reconhecido como padrao antigo e adaptado em memoria.
# Valores personalizados continuam limitando a rodada; legado preserva tambem 90/30.
OLLAMA_EQUIPE_TIMEOUT=90
OLLAMA_EQUIPE_TIMEOUT_MODELO=30

# Voz local é o padrão; a preparação automática baixa os pesos uma vez.
VOZ_PROVEDOR=local
VOZ_MODELO_LOCAL=base

# 9Router e opcional; configure contas/combos no dashboard local antes de habilitar.
# Mesmo em loopback, o gateway pode encaminhar mensagens/historico a provedores externos.
NINE_ROUTER_HABILITADO=0
NINE_ROUTER_URL=http://127.0.0.1:20128/v1
NINE_ROUTER_MODEL=
NINE_ROUTER_API_KEY=
NINE_ROUTER_TIMEOUT=30
# Memoria usa somente notas informadas e confirmadas pelo dono, por conversa.
MEMORIA_HABILITADA=1
