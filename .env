# Copie este arquivo como .env. NUNCA envie .env no Telegram nem ao GitHub.
# REVOGUE as credenciais antigas que estiveram embutidas no código original.
TELEGRAM_TOKEN=""
TELEGRAM_ALLOWED_USER_IDS=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
EXA_API_KEY=""
GEMINI_MODEL=gemini-3.5-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
PAINEL_PORTA=8765
# Opcional: diretório com os arquivos da versão anterior (migrados uma única vez).
# CAMINHO_LEGADO=C:\Users\SEU_USUARIO\Desktop
# ROBOTASK_TASKS_DIR=C:\Users\SEU_USUARIO\AppData\Local\RoboTask\Tasks
# Opcional: integração Google Calendar leitura (ative usando autorizar_google.bat)
# GOOGLE_OAUTH_CREDENTIALS=C:\Users\SEU_USUARIO\Desktop\credentials.json
AUTOANALISE_INTERVALO_MIN=360
REINICIO_WINDOWS_HABILITADO=0
REINICIO_WINDOWS_ATRASO_SEG=120
OLLAMA_HABILITADO=1
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
